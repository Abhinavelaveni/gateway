
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container"
    },
    "checkout-portal": {
      "root": "apps/checkout-portal",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "coin-wallet-store": {
      "root": "apps/coin-wallet-store",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "control-center": {
      "root": "apps/control-center",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "gmail-observer": {
      "root": "apps/gmail-observer",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "merchant-admin": {
      "root": "apps/merchant-admin",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "payment-api": {
      "root": "apps/payment-api",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "payment-help": {
      "root": "apps/payment-help",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "sms-observer": {
      "root": "apps/sms-observer",
      "runtime": "node",
      "entrypoint": "src/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
